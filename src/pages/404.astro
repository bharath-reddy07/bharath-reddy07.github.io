---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="page wrap">
    <h1>Not found</h1>
    <p class="lede">
      That page doesn't exist. Try <a href="/">the home page</a> or <a
        href="/work/">the work</a
      >.
    </p>
  </section>
</Base>

<style>
  .wrap {
    padding-block: clamp(3rem, 10vw, 6rem);
  }
  .wrap h1 {
    margin-bottom: 0.9rem;
  }
</style>
