---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  /** CSS colour for this card's accent, e.g. "var(--c2)". */
  accent?: string;
  /** Stagger index for the scroll-reveal. */
  step?: number;
}

const { entry, accent = 'var(--c1)', step = 0 } = Astro.props;
const { title, summary, tags, period, org } = entry.data;
---

<a
  class="card"
  href={`/work/${entry.id}/`}
  style={`--hue: ${accent}`}
  data-reveal={step + 1}
>
  <div class="card__meta">
    <span class="card__org">{org}</span>
    <span class="card__period">{period}</span>
  </div>
  <h3 class="card__title">{title}</h3>
  <p class="card__summary">{summary}</p>
  <ul class="card__tags">
    {tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
  </ul>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 1.5rem 1.6rem 1.35rem;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      border-color 0.18s ease,
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  /* Each card carries its own hue: a permanent bar down the left edge,
     plus a wash that fades in from the top-left on hover. */
  .card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--hue);
    transform: scaleY(0.28);
    transform-origin: top;
    transition: transform 0.3s var(--ease);
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      120% 90% at 0% 0%,
      color-mix(in srgb, var(--hue) 11%, transparent),
      transparent 62%
    );
    opacity: 0;
    transition: opacity 0.3s var(--ease);
    pointer-events: none;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--hue) 35%, var(--rule));
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -16px color-mix(in srgb, var(--hue) 55%, transparent);
  }

  .card:hover::before {
    transform: scaleY(1);
  }

  .card:hover::after {
    opacity: 1;
  }

  .card > * {
    position: relative;
    z-index: 1;
  }

  .card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.55rem;
  }

  /* Employer chip. Deliberately NOT tinted with the card hue — two cards
     from the same org must render identically here, or the pairing the
     chip exists to communicate gets undercut by the colour coding. */
  .card__org {
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    color: var(--ink);
    background: var(--bg-sunken);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    padding: 0.14rem 0.6rem;
  }

  .card__period {
    font-size: 0.79rem;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .card__title {
    font-size: 1.22rem;
    margin: 0 0 0.55rem;
    transition: color 0.15s ease;
  }

  .card:hover .card__title {
    color: var(--hue);
  }

  .card__summary {
    margin: 0 0 1.25rem;
    font-size: 0.94rem;
    color: var(--ink-soft);
    line-height: 1.6;
    max-width: none;
    flex: 1;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card__tags li {
    font-size: 0.73rem;
    font-weight: 500;
    color: var(--ink-soft);
    background: var(--bg-sunken);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.18rem 0.62rem;
  }
</style>
