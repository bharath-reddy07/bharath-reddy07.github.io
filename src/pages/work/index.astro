---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

const work = (await getCollection('work', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title="Work"
  description="Case studies: MCP tooling, Elasticsearch retrieval, computer-vision research, and a patented fabric analyser."
>
  <section class="page head">
    <h1>Work</h1>
    <p class="lede">
      Four projects, written up properly. Two are from my research years and two
      are from production engineering — they are more related than they look.
    </p>
  </section>

  <section class="page section">
    <div class="cards">
      {
        work.map((entry, i) => (
          <WorkCard entry={entry} accent={`var(--c${(i % 4) + 1})`} step={i} />
        ))
      }
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 2rem;
  }

  .head h1 {
    margin-bottom: 0.9rem;
  }

  .cards {
    display: grid;
    gap: 1.15rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
